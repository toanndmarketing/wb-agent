# ==============================================================================
# Agent SEO Tool v2.0 — Configuration
# ==============================================================================

# ─── CRITICAL: Google Service Account ───
# Download from Google Cloud Console → APIs & Services → Credentials
# Place as service-account.json in project root
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─── TARGET SITE ───
# [Critical] URL Property trên Google Search Console
SITE_URL=https://example.com/

# [Critical] Sitemap URL dùng cho Indexing API và Technical Audit
SITEMAP_URL=https://example.com/sitemap.xml

# ─── GSC ANALYSIS OPTIONS ───
# Khoảng thời gian phân tích (ngày)
DAYS=30

# Giới hạn số hàng dữ liệu GSC
ROW_LIMIT=5000

# CTR threshold cho Low CTR analysis (0.03 = 3%)
CTR_THRESHOLD=0.03

# Cannibalization threshold (0.10 = 10%)
CANNIBAL_THRESHOLD=0.10

# Striking distance range
STRIKING_MIN=8
STRIKING_MAX=20

# ─── CRAWLER OPTIONS ───
# Số trang crawl đồng thời
CRAWL_CONCURRENCY=5

# Delay giữa các batch (ms)
CRAWL_DELAY=200

# Số trang tối đa crawl
MAX_PAGES=200

# User-Agent string cho crawler
USER_AGENT=Mozilla/5.0 (compatible; AgentSEOTool/2.0)

# ─── BRAND MENTIONS (Off-page) ───
# Tên thương hiệu để tìm mentions
BRAND_NAME=

# ─── GOOGLE CUSTOM SEARCH (Off-page) ───
# Tạo miễn phí tại: https://programmablesearchengine.google.com/
# API Key từ Google Cloud Console
GOOGLE_CSE_API_KEY=

# Search Engine ID
GOOGLE_CSE_ENGINE_ID=

# ─── SERPER API KEY (Khuyên dùng cho Content Gap) ───
# Đăng ký miễn phí 2,500 requests tại: https://serper.dev/
SERPER_API_KEY=
